# Particle-LM — local-only configuration. No cloud keys are used or needed.

# Ollama base URL (server-side only; the browser never talks to Ollama).
# 3090 PC on the LAN:
LLM_BASE_URL=http://192.168.87.10:11434
# Optional fallback (e.g. the LLM tunnel / NUC). Leave empty to disable.
LLM_FALLBACK_URL=http://192.168.87.10:11440
# Model already loaded on the 3090. Must exist in `ollama list`.
LLM_MODEL=gemma3:12b
# Per-request timeout in ms (first token can be slow on a cold model).
LLM_TIMEOUT_MS=45000
# Set to 1 to never call the LLM (local keyword parser only).
LLM_OFFLINE=0

# Web server
PORT=3000
# 127.0.0.1 = this machine only. Use 0.0.0.0 to test from a phone on the LAN.
HOST=127.0.0.1
