# Particle-LM — local-only configuration. No cloud keys are used or needed.

# Ollama base URL (server-side only; the browser never talks to Ollama).
# 3090 PC on the LAN:
LLM_BASE_URL=http://192.168.87.10:11434
# An INVALID value disables the LLM (offline parser) and logs a CONFIG ERROR at startup.
# Optional fallback (e.g. the LLM tunnel / NUC). Leave empty to disable.
LLM_FALLBACK_URL=http://192.168.87.10:11440
# Model already loaded on the 3090. Must exist in `ollama list`.
# Default gemma4:e4b (loaded + pinned on the 3090). Alternative: gemma3:12b
# (switching makes Ollama load it on the first prompt).
LLM_MODEL=gemma4:e4b
# Ollama `think` flag. false (default) turns reasoning off on thinking models such as
# gemma4:e4b, so the token budget goes to the JSON answer. gemma3:12b ignores it.
# true = allow thinking, omit = don't send the field at all.
LLM_THINK=false
# Max output tokens (Ollama options.num_predict).
LLM_NUM_PREDICT=600
# Timeout for the GET /api/tags health probe, in ms.
LLM_TAGS_TIMEOUT_MS=6000
# Connect / first-response timeout per Ollama URL, in ms. If the primary accepts the connection
# but sends no response headers in this time (asleep, wedged), the fallback URL is tried
# (or the offline parser if there is none). Ollama only answers once the model is loaded,
# so raise this if your model is often loaded cold.
LLM_CONNECT_TIMEOUT_MS=6000
# Overall per-prompt budget in ms, shared across primary + fallback (first token can be slow on a cold model).
LLM_TIMEOUT_MS=45000
# Set to 1 to never call the LLM (local keyword parser only).
LLM_OFFLINE=0

# Web server
PORT=3000
# 127.0.0.1 = this machine only. Use 0.0.0.0 to test from a phone on the LAN.
HOST=127.0.0.1
# Extra hostnames allowed in the Host header (comma separated). localhost, 127.0.0.1, ::1,
# this machine's hostname and all of its interface IPs are always allowed; anything else
# gets 421 (DNS-rebinding guard).
ALLOWED_HOSTS=
