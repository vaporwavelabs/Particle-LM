{
  "name": "particle-lm",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Interactive WebGL2 particle visualizer driven by a local Ollama LLM (no cloud APIs).",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "node server.ts --production",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json && node scripts/check-forbidden.mjs",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "e2e:llm": "tsx scripts/e2e-llm.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "^1.56.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.0.0"
  }
}
